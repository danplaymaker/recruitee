# Webflow API token (Site API token with CMS read/write scope)
WEBFLOW_API_TOKEN=

# Webflow "Jobs" collection id
WEBFLOW_COLLECTION_ID=

# Webflow site id. Required to push synced changes to the live domain
# (CMS-only publish leaves items in "queued to publish" state otherwise).
WEBFLOW_SITE_ID=

# Shared secret for manually triggering /api/sync-jobs.
# Vercel Cron automatically sends "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Optional override. Defaults to https://distilled.recruitee.com/api/offers/
# RECRUITEE_OFFERS_URL=
